{
  "color": {
    "$type": "color",
    "action": {
      "primary": {
        "$value": "{ff.color.primary-500}",
        "$description": "Primary action color (buttons, links)"
      },
      "primary-hover": {
        "$value": "{ff.color.primary-600}",
        "$description": "Primary action hover state"
      },
      "success": {
        "$value": "{ff.color.success-500}",
        "$description": "Success action color"
      }
    },
    "background": {
      "default": {
        "$value": "{ff.color.white}",
        "$description": "Default page background"
      },
      "subtle": {
        "$value": "{ff.color.gray-100}",
        "$description": "Subtle background for cards, panels"
      }
    },
    "text": {
      "primary": {
        "$value": "{ff.color.gray-900}",
        "$description": "Primary text color"
      },
      "secondary": {
        "$value": "{ff.color.gray-500}",
        "$description": "Secondary text color (muted)"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": "{ff.spacing.025}",
      "$description": "Extra small spacing (4px)"
    },
    "sm": {
      "$value": "{ff.spacing.050}",
      "$description": "Small spacing (8px)"
    },
    "md": {
      "$value": "{ff.spacing.100}",
      "$description": "Medium spacing (16px)"
    },
    "lg": {
      "$value": "{ff.spacing.150}",
      "$description": "Large spacing (24px)"
    },
    "xl": {
      "$value": "{ff.spacing.200}",
      "$description": "Extra large spacing (32px)"
    }
  },
  "font-family": {
    "$type": "fontFamily",
    "body": {
      "$value": "{ff.font-family.figtree}",
      "$description": "Body text font"
    },
    "heading": {
      "$value": "{ff.font-family.figtree}",
      "$description": "Heading font"
    }
  },
  "font-size": {
    "$type": "dimension",
    "xs": {
      "$value": "{ff.font-size.12}",
      "$description": "Extra small text"
    },
    "sm": {
      "$value": "{ff.font-size.14}",
      "$description": "Small text"
    },
    "md": {
      "$value": "{ff.font-size.16}",
      "$description": "Medium text (base)"
    },
    "lg": {
      "$value": "{ff.font-size.18}",
      "$description": "Large text"
    },
    "xl": {
      "$value": "{ff.font-size.24}",
      "$description": "Extra large text"
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "normal": {
      "$value": "{ff.font-weight.400}",
      "$description": "Normal weight"
    },
    "medium": {
      "$value": "{ff.font-weight.500}",
      "$description": "Medium weight"
    },
    "semibold": {
      "$value": "{ff.font-weight.600}",
      "$description": "Semi-bold weight"
    },
    "bold": {
      "$value": "{ff.font-weight.700}",
      "$description": "Bold weight"
    }
  },
  "radius": {
    "$type": "dimension",
    "button": {
      "$value": "{ff.radius.sm}",
      "$description": "Button border radius"
    },
    "card": {
      "$value": "{ff.radius.md}",
      "$description": "Card border radius"
    },
    "input": {
      "$value": "{ff.radius.sm}",
      "$description": "Input field border radius"
    },
    "modal": {
      "$value": "{ff.radius.modal}",
      "$description": "Modal border radius"
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": "{ff.shadow.sm}",
      "$description": "Card shadow"
    },
    "dropdown": {
      "$value": "{ff.shadow.md}",
      "$description": "Dropdown menu shadow"
    },
    "modal": {
      "$value": "{ff.shadow.lg}",
      "$description": "Modal shadow"
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "{ff.duration.150}",
      "$description": "Fast transitions (hover, focus)"
    },
    "normal": {
      "$value": "{ff.duration.300}",
      "$description": "Normal transitions (modals, dropdowns)"
    },
    "slow": {
      "$value": "{ff.duration.500}",
      "$description": "Slow transitions (page transitions)"
    }
  }
}
