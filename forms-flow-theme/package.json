{
  "name": "@formsflow/theme",
  "version": "8.2.0-alpha",
  "type": "module",
  "scripts": {
    "start": "webpack serve --mode=development",
    "build": "webpack --mode=production",
    "lint": "eslint src --ext js",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "build:tokens:precompute": "node ../tokens/scripts/precompute-colors.js",
    "build:tokens:core": "node config/style-dictionary.config.js ../../tokens/core.json core-tokens.css",
    "build:tokens:semantic": "node config/style-dictionary.config.js ../../tokens/semantic.json semantic-tokens.css",
    "build:tokens:figma": "node ../tokens/scripts/merge-for-figma.js",
    "build:tokens": "npm run build:tokens:precompute && npm run build:tokens:core && npm run build:tokens:semantic && npm run build:tokens:figma"
  },
  "devDependencies": {
    "@tokens-studio/sd-transforms": "^2.0.3",
    "css-loader": "^6.5.1",
    "mini-css-extract-plugin": "^2.5.2",
    "prettier": "^2.5.1",
    "sass-loader": "^13.2.0",
    "style-dictionary": "^5.3.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.65.0",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.3.1"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "sass": "^1.58.2"
  }
}
